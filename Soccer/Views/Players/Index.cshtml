@using Soccer.Models
@model IndexViewModel

@{
    ViewData["Title"] = "Гравці";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="m-0">Список гравців</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> + Додати нового гравця
    </a>
</div>

<div class="table-responsive">
    <table class="table table-hover table-striped align-middle border">
        <thead class="table-light">
            <tr>
                <th>
                    <sort-header action="Index" up="@Model.SortViewModel.Up"
                                 current="@Model.SortViewModel.Current" property="@Model.SortViewModel.NameSort">
                        Ім'я
                    </sort-header>
                </th>
                <th>
                    <sort-header action="Index" up="@Model.SortViewModel.Up"
                                 current="@Model.SortViewModel.Current" property="@Model.SortViewModel.AgeSort">
                        Вік
                    </sort-header>
                </th>
                <th>
                    <sort-header action="Index" up="@Model.SortViewModel.Up"
                                 current="@Model.SortViewModel.Current" property="@Model.SortViewModel.PositionSort">
                        Позиція
                    </sort-header>
                </th>
                <th>
                    <sort-header action="Index" up="@Model.SortViewModel.Up"
                                 current="@Model.SortViewModel.Current" property="@Model.SortViewModel.TeamSort">
                        Команда
                    </sort-header>
                </th>
                <th class="text-end">Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Players)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    <td>@(DateTime.Now.Year - item.BirthYear)</td>
                    <td>@Html.DisplayFor(modelItem => item.Position)</td>
                    <td>@Html.DisplayFor(modelItem => item.Team!.Name)</td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Редагувати">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Деталі">
                                <i class="bi bi-info-circle"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Видалити">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>